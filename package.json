{
  "name": "romeo-os-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:demo": "tsc -b && vite build --config vite.demo.config.ts",
    "format": "prettier --write src scripts index.html *.json *.ts README.md .github/workflows",
    "format:check": "prettier --check src scripts index.html *.json *.ts README.md .github/workflows",
    "deploy:demo": "npm run build:demo && node scripts/publish-demo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4"
  }
}
